// Prisma schema — https://pris.ly/d/prisma-schema
//
// Uses the Prisma 7 `prisma-client` generator (TypeScript query compiler, no Rust engine
// binary) with driver adapters, so the generated client bundles cleanly into the Next.js
// `standalone` output that the Homebrew service runs.
//
// The application currently supports SQLite only. DATABASE_URL controls the file location;
// src/data/prisma-client.ts rejects other URL schemes before constructing the adapter.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  apiKeys       ApiKey[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ApiKey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  referenceId         String
  prefix              String?
  key                 String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(false)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
}

model AuthSettings {
  id                  String    @id
  registrationEnabled Boolean   @default(false)
  bootstrapCompleted  Boolean   @default(false)
  bootstrapClaimId    String?
  bootstrapClaimedAt  DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model CliHealthSettings {
  id         String   @id
  checksJson String   @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Agent {
  id                               String                         @id
  name                             String
  hostname                         String
  version                          String
  osVersion                        String
  architecture                     String
  cpuModel                         String?
  memoryTotalBytes                 Float?
  memoryFreeBytes                  Float?
  diskTotalBytes                   Float?
  diskFreeBytes                    Float?
  capabilitiesJson                 String
  secretHash                       String                         @unique
  baseRepoDirectory                String?
  derivedDataLocationMode          String                         @default("DEFAULT")
  derivedDataPath                  String?
  buildsDirectory                  String?
  defaultBuildsDirectory           String?
  codebaseScanIntervalSeconds      Int?
  jobReconciliationIntervalSeconds Int?
  gitFetchIntervalSeconds          Int?
  heartbeatIntervalSeconds         Int?
  ipAddress                        String?
  lastSeenAt                       DateTime?
  disconnectedAt                   DateTime?
  createdAt                        DateTime                       @default(now())
  updatedAt                        DateTime                       @updatedAt
  jobs                             AgentJob[]
  ccusageCollections               CcusageCollectionAgent[]
  ccusageHistory                   CcusageHistory?
  auditEvents                      AgentAuditEvent[]
  codebases                        Codebase[]
  buildDataCollections             BuildDataCollectionAgent[]
  buildDataDeletionHistory         BuildDataDeletionHistory[]
  skillToolObservations            SkillToolObservation[]
  skillInstallations               SkillInstallation[]
  skillDeployments                 SkillDeployment[]
  skillSyncItems                   SkillSyncItem[]
  builds                           Build[]
  signingProfiles                  SigningProfileAsset[]
  signingCertificates              SigningCertificateAsset[]
  signingOperationItems            SigningOperationItem[]
  runs                             AgentRun[]
  runDrafts                        RunDraft[]
  runCommands                      RunCommand[]
  runProviderSyncs                 RunProviderSync[]
  targetedCommandDefinitions       CommandDefinition[]            @relation("CommandDefinitionTargetAgent")
  commandRuns                      CommandRun[]
  diskSpaceState                   AgentDiskSpaceState?
  derivedDataLocks                 DerivedDataLock[]
  derivedDataCleanupLeases         DerivedDataCleanupLease[]
  sourceBuildArtifactTransfers     BuildArtifactTransfer[]        @relation("BuildArtifactTransferSourceAgent")
  targetBuildArtifactTransfers     BuildArtifactTransfer[]        @relation("BuildArtifactTransferTargetAgent")
  targetBuildDeployments           BuildDeployment[]              @relation("BuildDeploymentTargetAgent")
  tailscaleServeAssignments        TailscaleServeAssignment[]
  tailscaleState                   TailscaleAgentState?
  tailscaleOperationItems          TailscaleServeOperationAgent[]
}

model AgentEnrollmentToken {
  id        String    @id
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model IosDevice {
  id                    String                   @id
  udid                  String                   @unique
  displayName           String
  product               String?
  osVersion             String?
  platform              String                   @default("IOS")
  status                String                   @default("PENDING")
  appleDeviceId         String?                  @unique
  appleStatus           String?
  registrationError     String?
  registrationClaimedAt DateTime?
  registeredAt          DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  enrollments           IosDeviceEnrollment[]
  ipObservations        IosDeviceIpObservation[]

  @@index([status, createdAt])
  @@index([lastSeenAt])
}

model IosDeviceEnrollment {
  id             String                   @id
  deviceId       String?
  tokenHash      String                   @unique
  displayName    String
  status         String                   @default("ISSUED")
  expiresAt      DateTime
  downloadedAt   DateTime?
  consumedAt     DateTime?
  responseDigest String?
  failureCode    String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  device         IosDevice?               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  ipObservations IosDeviceIpObservation[]

  @@index([deviceId, createdAt])
  @@index([status, expiresAt])
}

model IosDeviceIpObservation {
  id           String              @id
  deviceId     String?
  enrollmentId String
  ipAddress    String
  source       String
  headerSource String
  observedAt   DateTime            @default(now())
  device       IosDevice?          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  enrollment   IosDeviceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, source, ipAddress])
  @@index([deviceId, observedAt])
  @@index([enrollmentId, observedAt])
}

model IosDeviceSettings {
  id                                   String    @id
  organizationName                     String    @default("AI Development Environment")
  profileIdentifier                    String    @default("com.ai-development-environment.device-enrollment")
  signerCertificatePem                 String?
  signerFingerprint                    String?
  signerCreatedAt                      DateTime?
  signerExpiresAt                      DateTime?
  appStoreConnectPrivateKeyFingerprint String?
  appStoreConnectVerifiedAt            DateTime?
  appStoreConnectLastTestedAt          DateTime?
  appStoreConnectVerificationError     String?
  createdAt                            DateTime  @default(now())
  updatedAt                            DateTime  @updatedAt
}

model AgentJob {
  id                      String                        @id
  agentId                 String
  kind                    String
  payloadJson             String
  status                  String
  idempotencyKey          String
  resultJson              String?
  error                   String?
  timeoutSeconds          Int
  createdAt               DateTime                      @default(now())
  startedAt               DateTime?
  finishedAt              DateTime?
  updatedAt               DateTime                      @updatedAt
  ccusageCollectionId     String?
  buildDataCollectionId   String?
  codebaseId              String?
  worktreeId              String?
  visibility              String                        @default("USER")
  blocksGitOperations     Boolean                       @default(false)
  agent                   Agent                         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ccusageCollection       CcusageCollection?            @relation(fields: [ccusageCollectionId], references: [id], onDelete: SetNull)
  buildDataCollection     BuildDataCollection?          @relation(fields: [buildDataCollectionId], references: [id], onDelete: SetNull)
  codebase                Codebase?                     @relation(fields: [codebaseId], references: [id], onDelete: SetNull)
  logs                    AgentJobLog[]
  builds                  Build[]
  deployments             BuildDeployment[]
  sourceArtifactTransfers BuildArtifactTransfer[]       @relation("BuildArtifactTransferSourceJob")
  targetArtifactTransfers BuildArtifactTransfer[]       @relation("BuildArtifactTransferTargetJob")
  exports                 BuildExport[]
  signingOperationItems   SigningOperationItem[]
  commandRunAttempt       CommandRunAttempt?
  tailscaleOperationItem  TailscaleServeOperationAgent?

  @@unique([agentId, idempotencyKey])
  @@index([agentId, status, createdAt])
  @@index([ccusageCollectionId, status])
  @@index([buildDataCollectionId, status])
  @@index([codebaseId, status, createdAt])
  @@index([worktreeId, status, createdAt])
}

model TailscaleServeTemplate {
  id                  String                     @id
  name                String
  protocol            String
  listenPort          Int
  mountPath           String                     @default("/")
  destinationProtocol String
  destinationPort     Int
  destinationPath     String                     @default("")
  funnel              Boolean                    @default(false)
  appCapabilitiesJson String                     @default("[]")
  proxyProtocol       String                     @default("NONE")
  fingerprint         String                     @unique
  revision            Int                        @default(1)
  lifecycle           String                     @default("ACTIVE")
  origin              String                     @default("USER")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  assignments         TailscaleServeAssignment[]
  operations          TailscaleServeOperation[]

  @@index([lifecycle, createdAt])
  @@index([protocol, listenPort, mountPath])
}

model TailscaleServeAssignment {
  templateId          String
  agentId             String
  desiredEnabled      Boolean                @default(true)
  observedEnabled     Boolean                @default(false)
  observedFingerprint String?
  revision            Int                    @default(1)
  status              String                 @default("PENDING")
  lastJobId           String?
  lastError           String?
  lastObservedAt      DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  template            TailscaleServeTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  agent               Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([templateId, agentId])
  @@index([agentId, status])
  @@index([lastJobId])
}

model TailscaleAgentState {
  agentId         String    @id
  dnsHostname     String?
  ipv4Json        String    @default("[]")
  ipv6Json        String    @default("[]")
  backendState    String    @default("Unknown")
  routesJson      String    @default("[]")
  lastInspectedAt DateTime?
  lastError       String?
  updatedAt       DateTime  @updatedAt
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model TailscaleServeOperation {
  id         String                         @id
  kind       String
  status     String                         @default("QUEUING")
  requestId  String                         @unique
  templateId String?
  createdAt  DateTime                       @default(now())
  finishedAt DateTime?
  updatedAt  DateTime                       @updatedAt
  template   TailscaleServeTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  agents     TailscaleServeOperationAgent[]

  @@index([templateId, createdAt])
  @@index([status, createdAt])
}

model TailscaleServeOperationAgent {
  operationId String
  agentId     String
  status      String                  @default("QUEUING")
  jobId       String?                 @unique
  error       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  operation   TailscaleServeOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  agent       Agent                   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  job         AgentJob?               @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@id([operationId, agentId])
  @@index([agentId, status])
}

model CodebaseRepository {
  id                     String                          @id
  canonicalOrigin        String                          @unique
  displayOrigin          String
  name                   String
  description            String                          @default("")
  jiraBranchRegex        String?
  keepBaseBranchUpToDate Boolean                         @default(true)
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  codebases              Codebase[]
  skillGroups            CodebaseRepositorySkillGroup[]
  projects               CodebaseProject[]
  buildScripts           CodebaseRepositoryBuildScript[]
  githubWorkflowRuns     GitHubWorkflowRunObservation[]
  githubPollingState     GitHubActionsPollingState?
  quickActionWorkflows   WorkflowQuickActionRepository[]
  commandDefinitions     CommandDefinitionRepository[]
  apps                   AppRepository[]
  runs                   AgentRun[]
  builds                 Build[]
  preparations           CodebaseRepositoryPreparation[]

  @@index([name])
}

model CodebaseRepositoryPreparation {
  id             String                      @id
  repositoryId   String
  kind           String
  path           String
  contents       Bytes?
  contentSha256  String?
  byteCount      Int?
  definitionHash String
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  repository     CodebaseRepository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  statuses       WorktreePreparationStatus[]

  @@unique([repositoryId, path])
  @@index([repositoryId, kind, path])
}

model App {
  id             String          @id
  name           String
  normalizedName String          @unique
  description    String          @default("")
  agentIdsJson   String          @default("[]")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  repositories   AppRepository[]

  @@index([name])
}

model AppRepository {
  appId        String
  repositoryId String
  createdAt    DateTime           @default(now())
  app          App                @relation(fields: [appId], references: [id], onDelete: Cascade)
  repository   CodebaseRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@id([appId, repositoryId])
  @@index([repositoryId, appId])
}

model Codebase {
  id                 String                   @id
  repositoryId       String
  agentId            String
  folder             String
  observedOrigin     String
  branch             String?
  headSha            String?
  upstream           String?
  ahead              Int?
  behind             Int?
  syncState          String                   @default("UNKNOWN")
  availability       String                   @default("AVAILABLE")
  statusError        String?
  defaultBranch      String?
  localBranchesJson  String                   @default("[]")
  remoteBranchesJson String                   @default("[]")
  lastCheckedAt      DateTime?
  lastFetchedAt      DateTime?
  lastFetchAttemptAt DateTime?
  lastFetchError     String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  repository         CodebaseRepository       @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  agent              Agent                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  jobs               AgentJob[]
  worktrees          Worktree[]
  skillInstallations SkillInstallation[]
  skillDeployments   SkillDeployment[]
  sourceObservations BuildSourceObservation[]
  builds             Build[]

  @@unique([agentId, folder])
  @@index([repositoryId])
  @@index([agentId, availability])
}

model CodebaseSettings {
  id                     String   @id
  refreshIntervalSeconds Int      @default(30)
  fetchIntervalSeconds   Int      @default(300)
  defaultJiraBranchRegex String   @default("\\b([A-Z][A-Z0-9_]*-\\d+)\\b")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Worktree {
  id                       String                       @id
  codebaseId               String
  gitDirectory             String
  folder                   String
  relativePath             String
  primary                  Boolean                      @default(false)
  branch                   String?
  headSha                  String?
  codeStateHash            String?
  upstream                 String?
  ahead                    Int?
  behind                   Int?
  syncState                String                       @default("UNKNOWN")
  baseBranchOverride       String?
  baseAhead                Int?
  baseBehind               Int?
  hasStagedChanges         Boolean                      @default(false)
  hasUnstagedChanges       Boolean                      @default(false)
  rebaseInProgress         Boolean                      @default(false)
  hasConflicts             Boolean                      @default(false)
  pushStatus               String                       @default("UNKNOWN")
  highlightColor           String?
  availability             String                       @default("AVAILABLE")
  statusError              String?
  lastCheckedAt            DateTime?
  missingAt                DateTime?
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  codebase                 Codebase                     @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  tags                     WorktreeTagAssignment[]
  buildDataDeletionHistory BuildDataDeletionHistory[]
  skillInstallations       SkillInstallation[]
  skillDeployments         SkillDeployment[]
  sourceObservations       BuildSourceObservation[]
  builds                   Build[]
  notifications            AppNotification[]
  runs                     AgentRun[]
  runDrafts                RunDraft[]
  runLeases                WorktreeRunLease[]
  runConcurrencyLanes      WorktreeRunConcurrencyLane[]
  admissionLane            WorktreeAdmissionLane?
  exclusiveWorkflowLease   WorktreeWorkflowLease?
  workflowRuns             WorkflowRun[]
  commandRuns              CommandRun[]
  derivedDataCleanupLease  DerivedDataCleanupLease?
  autoSync                 WorktreeAutoSync?
  autoMerge                WorktreeAutoMerge?
  pullRequestLookupOrigin  String?
  pullRequestLookupBranch  String?
  pullRequestLookupAt      DateTime?
  pullRequest              WorktreePullRequest?
  gitLabMergeRequest       WorktreeGitLabMergeRequest?
  preparationStatuses      WorktreePreparationStatus[]

  @@unique([codebaseId, gitDirectory])
  @@index([codebaseId, missingAt])
  @@index([missingAt])
}

model WorktreePreparationStatus {
  worktreeId     String
  preparationId  String
  definitionHash String
  state          String
  message        String?
  checkedAt      DateTime
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt
  worktree       Worktree                      @relation(fields: [worktreeId], references: [id], onDelete: Cascade)
  preparation    CodebaseRepositoryPreparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)

  @@id([worktreeId, preparationId])
  @@index([preparationId, state])
  @@index([worktreeId, state])
}

model WorktreePullRequest {
  worktreeId                  String   @id
  sourceControlProvider       String   @default("GITHUB")
  githubId                    String
  number                      Int
  title                       String
  url                         String
  repositoryGithubId          String
  repositoryNameWithOwner     String
  repositoryUrl               String
  labelsJson                  String
  jiraKey                     String?
  reviewDecision              String
  unresolvedReviewThreadCount Int
  state                       String
  isDraft                     Boolean
  mergeable                   String
  mergeStateStatus            String
  autoMergeEnabled            Boolean
  viewerCanEnableAutoMerge    Boolean
  viewerCanDisableAutoMerge   Boolean
  headRefOid                  String
  headRefName                 String
  githubCreatedAt             DateTime
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  worktree                    Worktree @relation(fields: [worktreeId], references: [id], onDelete: Cascade)

  @@index([githubId])
}

model WorktreeGitLabMergeRequest {
  worktreeId                  String    @id
  sourceControlProvider       String    @default("GITLAB")
  gitlabId                    String
  iid                         Int
  projectId                   String
  title                       String
  description                 String
  webUrl                      String
  state                       String
  draft                       Boolean
  sourceBranch                String
  targetBranch                String
  sha                         String
  authorJson                  String
  reviewersJson               String
  labelsJson                  String
  detailedMergeStatus         String
  mergeWhenPipelineSucceeds   Boolean
  squashOnMerge               Boolean
  hasConflicts                Boolean
  blockingDiscussionsResolved Boolean
  gitlabCreatedAt             DateTime
  gitlabUpdatedAt             DateTime
  mergedAt                    DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  worktree                    Worktree  @relation(fields: [worktreeId], references: [id], onDelete: Cascade)

  @@index([gitlabId])
  @@index([projectId, iid])
}

model GitHubPipelineSnapshot {
  id                      String                 @id
  sourceControlProvider   String                 @default("GITHUB")
  repositoryGithubId      String
  repositoryNameWithOwner String
  repositoryUrl           String
  headSha                 String
  pipelineStatus          String
  graphqlRollupStatus     String?
  revision                Int                    @default(0)
  lastGraphqlSyncAt       DateTime?
  lastObservedAt          DateTime
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  records                 GitHubPipelineRecord[]

  @@unique([repositoryGithubId, headSha])
  @@index([lastObservedAt])
}

model GitHubPipelineRecord {
  id                     String                 @id
  sourceControlProvider  String                 @default("GITHUB")
  snapshotId             String
  identityKey            String
  githubPipelineId       String
  name                   String
  status                 String
  url                    String?
  checkSuiteId           String?
  workflowRunId          String?
  workflowId             String?
  runNumber              Int?
  runAttempt             Int?
  canRetry               Boolean                @default(false)
  retryUnavailableReason String?
  jobsJson               String                 @default("[]")
  source                 String
  githubUpdatedAt        DateTime?
  sourceFetchedAt        DateTime
  lastObservedAt         DateTime
  optimisticUntil        DateTime?
  isCurrent              Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  snapshot               GitHubPipelineSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, identityKey])
  @@index([snapshotId, isCurrent])
  @@index([workflowRunId])
  @@index([checkSuiteId])
  @@index([lastObservedAt])
}

model WorktreeAutoSync {
  worktreeId             String    @id
  state                  String    @default("ACTIVE")
  branch                 String
  conflictWorkflowId     String?
  conflictWorkflowChoice String?
  activeJobId            String?
  workflowRunId          String?
  lastError              String?
  pauseReason            String?
  lastSyncedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  worktree               Worktree  @relation(fields: [worktreeId], references: [id], onDelete: Cascade)
  conflictWorkflow       Workflow? @relation(fields: [conflictWorkflowId], references: [id], onDelete: SetNull)

  @@index([state, updatedAt])
  @@index([conflictWorkflowId])
}

model WorktreeAutoMerge {
  worktreeId              String    @id
  state                   String    @default("ACTIVE")
  repositoryNameWithOwner String
  pullRequestNumber       Int
  branch                  String
  mergeMethod             String
  commitHeadline          String
  commitBody              String    @default("")
  authorEmail             String?
  deleteWorktree          Boolean   @default(false)
  moveTicketToDone        Boolean   @default(false)
  ticketKey               String?
  ticketMovedAt           DateTime?
  deleteJobId             String?
  lastError               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  worktree                Worktree  @relation(fields: [worktreeId], references: [id], onDelete: Cascade)

  @@index([state, updatedAt])
  @@index([repositoryNameWithOwner, pullRequestNumber])
}

model AgentRun {
  id                       String              @id
  kind                     String
  displayNumber            Int
  status                   String              @default("IN_PROGRESS")
  phase                    String              @default("QUEUED")
  origin                   String              @default("MANAGED")
  provider                 String
  providerVersion          String?
  worktreeId               String?
  repositoryId             String?
  agentId                  String?
  jiraIssueKey             String?
  repositoryName           String
  branch                   String?
  model                    String
  effort                   String?
  webSearchEnabled         Boolean             @default(false)
  mcpPresetIdsJson         String              @default("[]")
  mcpToolNamesJson         String              @default("[]")
  worktreeConcurrencyLimit Int                 @default(0)
  workflowRunId            String?
  initialPrompt            String
  finalOutput              String?
  error                    String?
  estimatedCost            Float?
  pricingSource            String?
  pricingUpdatedAt         DateTime?
  inputTokens              Int                 @default(0)
  outputTokens             Int                 @default(0)
  reasoningTokens          Int                 @default(0)
  cacheReadTokens          Int                 @default(0)
  cacheWriteTokens         Int                 @default(0)
  toolCallCount            Int                 @default(0)
  sourcePlanId             String?             @unique
  sourcePlanNumber         Int?
  playedAt                 DateTime?
  playedSessionNumber      Int?
  parentRunId              String?
  parentRunNumber          Int?
  followUpMode             String?
  archivedAt               DateTime?
  nativeArchivedAt         DateTime?
  startedAt                DateTime?
  finishedAt               DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  worktree                 Worktree?           @relation(fields: [worktreeId], references: [id], onDelete: SetNull)
  repository               CodebaseRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  workflowRun              WorkflowRun?        @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)
  agent                    Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sourcePlan               AgentRun?           @relation("PlanSession", fields: [sourcePlanId], references: [id], onDelete: SetNull)
  playedSession            AgentRun?           @relation("PlanSession")
  parentRun                AgentRun?           @relation("RunFollowUps", fields: [parentRunId], references: [id], onDelete: SetNull)
  followUps                AgentRun[]          @relation("RunFollowUps")
  attempts                 RunAttempt[]
  inputs                   RunInput[]
  events                   RunEvent[]
  toolCalls                RunToolCall[]
  modelUsage               RunModelUsage[]
  questionBatches          RunQuestionBatch[]
  checkpoints              RunCheckpoint[]
  commands                 RunCommand[]
  lease                    WorktreeRunLease?

  @@unique([kind, displayNumber])
  @@index([kind, archivedAt, createdAt])
  @@index([worktreeId, status, createdAt])
  @@index([worktreeId, kind, status, createdAt])
  @@index([repositoryId, kind, archivedAt, createdAt])
  @@index([workflowRunId, createdAt])
  @@index([agentId, provider, createdAt])
  @@index([parentRunId, createdAt])
}

model RunAttempt {
  id              String             @id
  runId           String
  generation      Int
  nativeId        String?
  nativeKey       String?            @unique
  status          String             @default("STARTING")
  resumeStrategy  String?
  rawMetadataJson String?
  startedAt       DateTime           @default(now())
  finishedAt      DateTime?
  supersededAt    DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  run             AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  events          RunEvent[]
  toolCalls       RunToolCall[]
  modelUsage      RunModelUsage[]
  questionBatches RunQuestionBatch[]
  checkpoints     RunCheckpoint[]

  @@unique([runId, generation])
  @@index([runId, status])
}

model RunInput {
  id          String          @id
  runId       String
  sequence    Int
  kind        String
  prompt      String
  createdAt   DateTime        @default(now())
  run         AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  attachments RunAttachment[]

  @@unique([runId, sequence])
  @@index([runId, createdAt])
}

model RunDraft {
  id               String          @id
  kind             String
  worktreeId       String?
  agentId          String?
  jiraIssueKey     String?
  provider         String
  model            String
  effort           String?
  webSearchEnabled Boolean         @default(false)
  mcpPresetIdsJson String          @default("[]")
  prompt           String
  archivedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  worktree         Worktree?       @relation(fields: [worktreeId], references: [id], onDelete: SetNull)
  agent            Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  attachments      RunAttachment[]

  @@index([archivedAt, updatedAt])
  @@index([worktreeId, updatedAt])
}

model RunAttachment {
  id          String    @id
  inputId     String?
  draftId     String?
  sha256      String
  filename    String
  contentType String
  size        Int
  storagePath String
  createdAt   DateTime  @default(now())
  input       RunInput? @relation(fields: [inputId], references: [id], onDelete: Cascade)
  draft       RunDraft? @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([inputId])
  @@index([draftId])
  @@index([sha256])
}

model RunEvent {
  id             String      @id
  runId          String
  attemptId      String?
  sequence       Int
  type           String
  summary        String
  searchText     String
  detailMarkdown String?
  rawJson        String?
  createdAt      DateTime    @default(now())
  supersededAt   DateTime?
  run            AgentRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt        RunAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([runId, sequence])
  @@index([runId, supersededAt, sequence])
}

model RunToolCall {
  id           String      @id
  runId        String
  attemptId    String?
  sequence     Int
  name         String
  status       String
  inputJson    String?
  outputJson   String?
  error        String?
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  supersededAt DateTime?
  run          AgentRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt      RunAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([runId, sequence])
  @@index([runId, startedAt])
}

model RunModelUsage {
  id               String      @id
  runId            String
  attemptId        String?
  model            String
  inputTokens      Int         @default(0)
  outputTokens     Int         @default(0)
  reasoningTokens  Int         @default(0)
  cacheReadTokens  Int         @default(0)
  cacheWriteTokens Int         @default(0)
  estimatedCost    Float?
  superseded       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  run              AgentRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt          RunAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([runId, attemptId, model])
  @@index([runId, model])
}

/// Where the model price catalog is fetched from, and when it last landed. One row.
model ModelCostSettings {
  id         String    @id
  catalogUrl String?
  fetchedAt  DateTime?
  sourceUrl  String?
  entryCount Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// One model's published prices, in cost per token as the upstream catalog states them.
/// Prices are shown per million tokens, but storing the upstream unit keeps the rounding
/// out of the stored value.
model ModelCostEntry {
  model                  String   @id
  provider               String?
  mode                   String?
  inputCostPerToken      Float?
  outputCostPerToken     Float?
  cacheReadCostPerToken  Float?
  cacheWriteCostPerToken Float?
  maxInputTokens         Int?
  maxOutputTokens        Int?
  updatedAt              DateTime @updatedAt

  @@index([provider])
}

model RunQuestionBatch {
  id                    String               @id
  runId                 String?
  workflowStepAttemptId String?
  attemptId             String?
  nativeRequestId       String?
  eventSequence         Int?
  status                String               @default("PENDING")
  createdAt             DateTime             @default(now())
  answeredAt            DateTime?
  supersededAt          DateTime?
  revisionPreparedAt    DateTime?
  rollbackPatch         String?
  pushedCommitWarning   String?
  run                   AgentRun?            @relation(fields: [runId], references: [id], onDelete: Cascade)
  workflowStepAttempt   WorkflowStepAttempt? @relation(fields: [workflowStepAttemptId], references: [id], onDelete: Cascade)
  attempt               RunAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  questions             RunQuestion[]
  answerRevisions       RunAnswerRevision[]
  checkpoint            RunCheckpoint?

  @@unique([runId, nativeRequestId])
  @@unique([workflowStepAttemptId, nativeRequestId])
  @@index([runId, status, createdAt])
  @@index([workflowStepAttemptId, status, createdAt])
}

model RunQuestion {
  id          String              @id
  batchId     String
  position    Int
  header      String?
  prompt      String
  multiSelect Boolean             @default(false)
  allowCustom Boolean             @default(true)
  batch       RunQuestionBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  options     RunQuestionOption[]

  @@unique([batchId, position])
}

model RunQuestionOption {
  id          String      @id
  questionId  String
  position    Int
  label       String
  description String?
  question    RunQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, position])
}

model RunAnswerRevision {
  id                   String           @id
  batchId              String
  revision             Int
  answersJson          String
  createdAt            DateTime         @default(now())
  supersededAt         DateTime?
  replacementAttemptId String?
  batch                RunQuestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, revision])
}

model RunCheckpoint {
  id                    String               @id
  runId                 String?
  workflowStepAttemptId String?
  attemptId             String?
  questionBatchId       String?              @unique
  kind                  String
  headSha               String?
  branch                String?
  upstreamSha           String?
  indexTree             String?
  worktreeTree          String?
  refName               String?
  manifestJson          String?
  diffSummary           String?
  diffPatch             String?
  stashRef              String?
  createdAt             DateTime             @default(now())
  run                   AgentRun?            @relation(fields: [runId], references: [id], onDelete: Cascade)
  workflowStepAttempt   WorkflowStepAttempt? @relation(fields: [workflowStepAttemptId], references: [id], onDelete: Cascade)
  attempt               RunAttempt?          @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  questionBatch         RunQuestionBatch?    @relation(fields: [questionBatchId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@index([workflowStepAttemptId, createdAt])
}

model RunCommand {
  id             String    @id
  runId          String
  agentId        String
  sequence       Int
  type           String
  payloadJson    String
  status         String    @default("QUEUED")
  idempotencyKey String    @unique
  error          String?
  createdAt      DateTime  @default(now())
  claimedAt      DateTime?
  finishedAt     DateTime?
  run            AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([agentId, status, createdAt])
}

model RunNumberSequence {
  kind      String   @id
  nextValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model WorktreeRunLease {
  id             String   @id
  worktreeId     String
  runId          String   @unique
  purpose        String   @default("RUN")
  reservationKey String?
  acquiredAt     DateTime @default(now())
  worktree       Worktree @relation(fields: [worktreeId], references: [id], onDelete: Cascade)
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([worktreeId, acquiredAt])
  @@index([worktreeId, purpose, acquiredAt])
}

model WorktreeRunConcurrencyLane {
  worktreeId String
  kind       String
  updatedAt  DateTime @updatedAt
  worktree   Worktree @relation(fields: [worktreeId], references: [id], onDelete: Cascade)

  @@id([worktreeId, kind])
}

model WorktreeAdmissionLane {
  worktreeId String   @id
  updatedAt  DateTime @updatedAt
  worktree   Worktree @relation(fields: [worktreeId], references: [id], onDelete: Cascade)
}

model WorktreeWorkflowLease {
  worktreeId    String      @id
  workflowRunId String      @unique
  acquiredAt    DateTime    @default(now())
  worktree      Worktree    @relation(fields: [worktreeId], references: [id], onDelete: Cascade)
  workflowRun   WorkflowRun @relation(fields: [workflowRunId], references: [id], onDelete: Cascade)
}

model RunProviderSync {
  id              String    @id
  agentId         String
  provider        String
  cursor          String?
  status          String    @default("IDLE")
  lastStartedAt   DateTime?
  lastCompletedAt DateTime?
  lastError       String?
  importedCount   Int       @default(0)
  unmatchedCount  Int       @default(0)
  catalogJson     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, provider])
  @@index([status, updatedAt])
}

model AppNotification {
  id                 String    @id
  dedupeKey          String    @unique
  typeKey            String
  title              String
  body               String
  href               String
  resourceKind       String
  resourceId         String
  worktreeId         String?
  highlightColor     String?
  sidebarRequested   Boolean
  browserRequested   Boolean
  webPushRequested   Boolean
  apnsRequested      Boolean   @default(false)
  sidebarDismissedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  worktree           Worktree? @relation(fields: [worktreeId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([typeKey, createdAt])
  @@index([worktreeId])
  @@index([sidebarRequested, sidebarDismissedAt, createdAt])
}

model NotificationPreference {
  typeKey        String   @id
  sidebarEnabled Boolean
  browserEnabled Boolean
  webPushEnabled Boolean
  apnsEnabled    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Devices that receive this control plane's own notifications over APNs. Distinct from
// `ApnsRegistration`, which belongs to the push-notifications test console and holds devices
// belonging to whatever apps are being built with this server.
model NotificationDevice {
  id                   String    @id
  clientRegistrationId String    @unique
  token                String
  tokenHash            String    @unique
  topic                String
  environment          String
  displayName          String
  deviceModel          String?
  osVersion            String?
  appVersion           String?
  appBuild             String?
  locale               String?
  lastIpAddress        String?
  status               String    @default("ACTIVE")
  lastFailureReason    String?
  lastFailureAt        DateTime?
  lastRegisteredAt     DateTime  @default(now())
  lastDeliveredAt      DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status, lastRegisteredAt])
}

model WebPushSettings {
  id               String    @id
  vapidPublicKey   String?
  vapidGeneratedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model WebPushSubscription {
  id             String    @id
  endpoint       String    @unique
  p256dh         String
  auth           String
  expirationTime DateTime?
  locale         String?
  userAgent      String?
  lastSeenAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([lastSeenAt])
}

model Skill {
  id            String              @id
  name          String              @unique
  description   String
  syncGlobally  Boolean             @default(true)
  packageHash   String
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  files         SkillFile[]
  groups        SkillGroupSkill[]
  installations SkillInstallation[]
  baselines     SkillSyncBaseline[]
  deployments   SkillDeployment[]
  syncItems     SkillSyncItem[]

  @@index([name])
  @@index([deletedAt, updatedAt])
}

model SkillFile {
  id          String   @id
  skillId     String
  path        String
  contents    Bytes
  executable  Boolean  @default(false)
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, path])
  @@index([skillId])
}

model SkillGroup {
  id           String                         @id
  name         String                         @unique
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  skills       SkillGroupSkill[]
  repositories CodebaseRepositorySkillGroup[]
  syncRuns     SkillSyncRun[]

  @@index([name])
}

model SkillGroupSkill {
  groupId String
  skillId String
  group   SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  skill   Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([groupId, skillId])
  @@index([skillId])
}

model CodebaseRepositorySkillGroup {
  repositoryId String
  groupId      String
  repository   CodebaseRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  group        SkillGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([repositoryId, groupId])
  @@index([groupId])
}

model SkillSettings {
  id                    String   @id
  autoSyncProjectGroups Boolean  @default(false)
  cursorEnabled         Boolean  @default(true)
  githubCopilotEnabled  Boolean  @default(true)
  codexEnabled          Boolean  @default(true)
  claudeEnabled         Boolean  @default(true)
  openCodeEnabled       Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model SkillToolObservation {
  agentId    String
  tool       String
  configured Boolean  @default(false)
  homePath   String
  checkedAt  DateTime
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@id([agentId, tool])
  @@index([tool, configured])
}

model SkillInstallation {
  id            String             @id
  skillId       String?
  agentId       String
  codebaseId    String?
  worktreeId    String?
  scope         String
  rootKind      String
  rootPath      String
  skillName     String
  description   String
  packageHash   String
  present       Boolean            @default(true)
  fileCount     Int
  totalBytes    Int
  tracked       Boolean            @default(false)
  consumersJson String             @default("[]")
  lastSeenAt    DateTime
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  skill         Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
  agent         Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  codebase      Codebase?          @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  worktree      Worktree?          @relation(fields: [worktreeId], references: [id], onDelete: Cascade)
  baseline      SkillSyncBaseline?
  syncItems     SkillSyncItem[]

  @@unique([agentId, rootPath, skillName])
  @@index([skillName, packageHash])
  @@index([agentId, lastSeenAt])
  @@index([codebaseId])
  @@index([worktreeId])
}

model SkillSyncBaseline {
  id             String            @id
  installationId String            @unique
  skillId        String
  packageHash    String
  syncedAt       DateTime          @default(now())
  installation   SkillInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  skill          Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model SkillDeployment {
  id            String    @id
  skillId       String
  agentId       String
  codebaseId    String?
  worktreeId    String?
  scope         String
  rootKind      String
  targetPath    String
  desiredHash   String
  installedHash String?
  status        String    @default("PENDING")
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  skill         Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  codebase      Codebase? @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  worktree      Worktree? @relation(fields: [worktreeId], references: [id], onDelete: Cascade)

  @@unique([agentId, targetPath])
  @@index([skillId, status])
  @@index([codebaseId])
  @@index([worktreeId])
}

model SkillSyncRun {
  id         String          @id
  kind       String
  groupId    String?
  automatic  Boolean         @default(false)
  status     String
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  finishedAt DateTime?
  group      SkillGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  items      SkillSyncItem[]

  @@index([status, createdAt])
  @@index([groupId, createdAt])
}

model SkillSyncItem {
  id                   String             @id
  runId                String
  skillId              String?
  installationId       String?
  agentId              String?
  direction            String
  status               String
  sourceHash           String?
  targetHash           String?
  resolution           String?
  candidatePackageJson String?
  error                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  run                  SkillSyncRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  skill                Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
  installation         SkillInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  agent                Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([runId, status])
  @@index([skillId])
  @@index([agentId])
}

model CodebaseProject {
  id             String               @id
  repositoryId   String
  type           String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  repository     CodebaseRepository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sources        BuildSource[]
  configurations BuildConfiguration[]

  @@unique([repositoryId, type])
  @@index([repositoryId])
}

model BuildSource {
  id             String                   @id
  projectId      String
  kind           String
  relativePath   String
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  project        CodebaseProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configurations BuildConfiguration[]
  observations   BuildSourceObservation[]

  @@unique([projectId, relativePath])
  @@index([projectId])
}

model BuildSourceObservation {
  id                 String      @id
  sourceId           String
  scopeKey           String
  codebaseId         String?
  worktreeId         String?
  status             String
  schemesJson        String      @default("[]")
  configurationsJson String      @default("[]")
  testPlansJson      String      @default("[]")
  error              String?
  stale              Boolean     @default(false)
  headSha            String?
  xcodeVersion       String?
  lastParseAttemptAt DateTime
  lastParsedAt       DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  source             BuildSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  codebase           Codebase?   @relation(fields: [codebaseId], references: [id], onDelete: Cascade)
  worktree           Worktree?   @relation(fields: [worktreeId], references: [id], onDelete: Cascade)

  @@unique([sourceId, scopeKey])
  @@index([codebaseId])
  @@index([worktreeId])
}

model BuildConfiguration {
  id                   String          @id
  projectId            String
  sourceId             String
  name                 String
  iconKey              String?
  scheme               String
  buildConfiguration   String
  defaultAction        String          @default("BUILD")
  advancedSettingsJson String          @default("{}")
  autoExport           Boolean         @default(false)
  exportSettingsJson   String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  project              CodebaseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source               BuildSource     @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  builds               Build[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([sourceId])
}

model BuildScript {
  id               String                          @id
  name             String                          @unique
  preBuildScript   String?
  postBuildScript  String?
  enabledByDefault Boolean                         @default(false)
  timeoutSeconds   Int                             @default(300)
  failureBehavior  String                          @default("FAIL_BUILD")
  deletedAt        DateTime?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  repositories     CodebaseRepositoryBuildScript[]
  executions       BuildScriptExecution[]

  @@index([deletedAt, name])
}

model CodebaseRepositoryBuildScript {
  repositoryId String
  scriptId     String
  position     Int                @default(0)
  repository   CodebaseRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  script       BuildScript        @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@id([repositoryId, scriptId])
  @@index([scriptId])
}

model Build {
  id                String                 @id
  requestKey        String                 @unique
  requestId         String
  agentId           String?
  codebaseId        String?
  worktreeId        String?
  repositoryId      String?
  configurationId   String?
  jobId             String?
  status            String                 @default("QUEUED")
  action            String
  destinationType   String
  destinationJson   String
  snapshotJson      String
  commandSummary    String
  artifactDirectory String
  errorCode         String?
  error             String?
  createdAt         DateTime               @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  updatedAt         DateTime               @updatedAt
  agent             Agent?                 @relation(fields: [agentId], references: [id], onDelete: SetNull)
  codebase          Codebase?              @relation(fields: [codebaseId], references: [id], onDelete: SetNull)
  worktree          Worktree?              @relation(fields: [worktreeId], references: [id], onDelete: SetNull)
  repository        CodebaseRepository?    @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  configuration     BuildConfiguration?    @relation(fields: [configurationId], references: [id], onDelete: SetNull)
