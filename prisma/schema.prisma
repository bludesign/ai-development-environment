  reports           BuildReport[]

  @@index([status, createdAt])
  @@index([agentId, createdAt])
  @@index([codebaseId, createdAt])
  @@index([worktreeId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([jobId])
}

model BuildArtifact {
  id           String                  @id
  buildId      String
  kind         String
  relativePath String
  sizeBytes    Float?
